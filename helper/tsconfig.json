{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "../src/live/protocol.ts", "../src/live/detector.ts", "../src/live/demo.ts"],
  "exclude": ["src/**/*.test.ts"]
}
