{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nightstint",
  "version": "0.1.0",
  "identifier": "com.nightstint.desktop",
  "build": {
    "frontendDist": "https://stint-planner-three.vercel.app"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Tomás Silva",
    "shortDescription": "Nightstint",
    "longDescription": "Nightstint for drivers: the planner in its own window, with the iRacing helper built in.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/nightstint-helper"
    ],
    "resources": {
      "../../helper/dist/": "helper/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1MzQwMjJGRkU2MUFGOTMKUldTVHIySCtMd0kwMWJTWGNFR05SZmdLZXM4NjBUYWZjdExOSWk1akYvYXcxelQ4T3gwSWhyTGcK",
      "endpoints": [
        "https://github.com/tomassilva03/stint-planner/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
